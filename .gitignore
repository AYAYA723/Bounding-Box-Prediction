# Only project code, documentation and small annotation files are tracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/.vscode/
!/predict_corner/
!/datasets/

# Interpreter selection belongs to this machine.
/.vscode/*
!/.vscode/extensions.json

# Core code and supporting scripts.
/predict_corner/*
!/predict_corner/*.py
!/predict_corner/README.md
!/predict_corner/tools/
!/predict_corner/tests/
!/predict_corner/docs/
!/predict_corner/data_prep/
/predict_corner/tools/*
!/predict_corner/tools/*.py
/predict_corner/tests/*
!/predict_corner/tests/*.py
/predict_corner/docs/*
!/predict_corner/docs/*.md
!/predict_corner/docs/figures/
/predict_corner/docs/figures/*
!/predict_corner/docs/figures/*.png
!/predict_corner/docs/figures/*.svg
/predict_corner/data_prep/*
!/predict_corner/data_prep/*.py
!/predict_corner/data_prep/*.md
!/predict_corner/data_prep/video_roi_annotations.json

# Keep only small dataset metadata and annotations.
/datasets/*
!/datasets/action4/
/datasets/action4/*
!/datasets/action4/README.md
!/datasets/action4/camera.json
!/datasets/action4/keypoints_3d.json
!/datasets/action4/models/
!/datasets/action4/train_pbr/
/datasets/action4/models/*
!/datasets/action4/models/models_info.json
/datasets/action4/train_pbr/*
!/datasets/action4/train_pbr/000000/
/datasets/action4/train_pbr/000000/*
!/datasets/action4/train_pbr/000000/scene_camera.json
!/datasets/action4/train_pbr/000000/scene_gt.json
!/datasets/action4/train_pbr/000000/scene_gt_info.json
!/datasets/action4/train_pbr/000000/keypoints_2d.json

# Generated experiments, checkpoints, archives and local environments.
/results/
/predict_corner/checkpoints/
/transfer/
/.cache/
/.runtimes/
/.venv*/

# Python caches and local settings.
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]
.ipynb_checkpoints/
*.ipynb
.env
.env.*
*.pt
*.pth
*.ckpt
*.log
